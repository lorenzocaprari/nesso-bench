#!/usr/bin/env python3
"""Compare two retrieval-eval JSON reports.

Prints a Markdown table of current vs previous scores per system, ranker,
class (or overall), and metric, plus one DROP line per relative drop beyond
the tolerance. When both reports carry per-query results, it also prints a
paired bootstrap interval for each class whose per-query MRR changed and lists
the queries that moved. Scores never fail the process unless --fail-on-worse is given: exit 0
whenever both reports parse. With --fail-on-worse, exit 3 and print one WORSE
line per nesso ranker, system, class, and metric (MRR, nDCG@10) that got worse
beyond noise on an unchanged query set. Exit non-zero only on unreadable or malformed input.

A ranker is a nesso mode (auto, hybrid, dense, lexical) or another engine
(grep, bm25, ...). Retrieval reports with schema_version 3 (nesso only) and 4
(engines[]) compare with each other; skipped engines are left out. Needle
reports ("kind": "needle") compare only with needle reports. Any other
mismatch prints a note and skips the comparison (exit 0).

`--margins-json` prints the same margin rows as JSON instead of the Markdown table.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import sys
import zlib
from pathlib import Path
from typing import Any

METRICS = ("recall_at_10", "mrr", "ndcg_at_10", "precision_at_10")
RETRIEVAL_SCHEMAS = frozenset({3, 4})
DEFAULT_TOLERANCE = 0.05


def load_report(path: Path) -> dict[str, Any]:
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: malformed JSON in {path}: {exc}") from exc
    if not isinstance(payload, dict):
        raise SystemExit(f"error: malformed JSON in {path}: top-level value must be an object")
    if "schema_version" not in payload:
        raise SystemExit(f"error: malformed JSON in {path}: missing schema_version")
    version = payload["schema_version"]
    if not isinstance(version, int) or isinstance(version, bool):
        raise SystemExit(f"error: malformed JSON in {path}: schema_version must be an int")
    return payload


def metrics_from(bucket: dict[str, Any] | None) -> dict[str, float] | None:
    if bucket is None:
        return None
    metrics = bucket.get("metrics")
    if not isinstance(metrics, dict):
        return None
    out: dict[str, float] = {}
    for name in METRICS:
        if name not in metrics:
            continue
        value = metrics[name]
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise SystemExit(f"error: malformed metrics value for {name}")
        out[name] = float(value)
    return out


def index_modes(modes: Any) -> dict[str, dict[str, Any]]:
    if not isinstance(modes, list):
        return {}
    found: dict[str, dict[str, Any]] = {}
    for mode in modes:
        if not isinstance(mode, dict):
            continue
        name = mode.get("mode")
        if isinstance(name, str):
            found[name] = mode
    return found


def index_classes(mode: dict[str, Any]) -> dict[str, dict[str, Any]]:
    found: dict[str, dict[str, Any]] = {}
    by_class = mode.get("by_class")
    if isinstance(by_class, list):
        for row in by_class:
            if not isinstance(row, dict):
                continue
            name = row.get("class")
            if isinstance(name, str):
                found[name] = row
    overall = mode.get("overall")
    if isinstance(overall, dict):
        found["overall"] = overall
    return found


def report_family(report: dict[str, Any]) -> str:
    return "needle" if report.get("kind") == "needle" else "retrieval"


def comparable(current: dict[str, Any], previous: dict[str, Any]) -> bool:
    family = report_family(current)
    if family != report_family(previous):
        return False
    if family == "retrieval":
        return current["schema_version"] in RETRIEVAL_SCHEMAS and previous["schema_version"] in RETRIEVAL_SCHEMAS
    return current["schema_version"] == previous["schema_version"]


def ranker_label(engine: str) -> str:
    """nesso rows are labelled by mode alone, as in schema 3 reports."""
    return engine.removeprefix("nesso/")


def iter_buckets(report: dict[str, Any]) -> list[tuple[str, str, str, dict[str, Any]]]:
    """Every (system, ranker, class, bucket) in report order."""
    found: list[tuple[str, str, str, dict[str, Any]]] = []

    def add_buckets(system: str, ranker: str, payload: dict[str, Any]) -> None:
        for class_name, bucket in index_classes(payload).items():
            found.append((system, ranker, class_name, bucket))

    def add_modes(system: str, modes_payload: Any) -> None:
        for mode_name, mode in index_modes(modes_payload).items():
            add_buckets(system, mode_name, mode)

    def add_engines(system: str, engines_payload: Any) -> None:
        if not isinstance(engines_payload, list):
            return
        for engine in engines_payload:
            if not isinstance(engine, dict) or engine.get("status") == "skipped":
                continue
            name = engine.get("engine")
            if not isinstance(name, str):
                continue
            if "modes" in engine:
                add_modes(system, engine.get("modes"))
            else:
                add_buckets(system, ranker_label(name), engine)

    def add_scope(system: str, payload: dict[str, Any]) -> None:
        if "engines" in payload:
            add_engines(system, payload.get("engines"))
        else:
            add_modes(system, payload.get("modes"))

    datasets = report.get("datasets")
    if isinstance(datasets, list):
        for entry in datasets:
            if not isinstance(entry, dict):
                continue
            name = entry.get("dataset")
            if isinstance(name, str):
                add_scope(name, entry)

    overall = report.get("overall")
    if isinstance(overall, dict):
        add_scope("overall", overall)

    return found


def unstable_rankers(report: dict[str, Any]) -> set[tuple[str, str]]:
    """(system, ranker) rows whose rankings changed across repeated quality runs."""
    found: set[tuple[str, str]] = set()
    scopes: list[tuple[str, Any]] = []
    for entry in report.get("datasets") or []:
        if isinstance(entry, dict) and isinstance(entry.get("dataset"), str):
            scopes.append((entry["dataset"], entry.get("engines")))
    overall = report.get("overall")
    if isinstance(overall, dict):
        scopes.append(("overall", overall.get("engines")))
    for system, engines in scopes:
        for engine in engines if isinstance(engines, list) else []:
            repeat = engine.get("quality_repeat") if isinstance(engine, dict) else None
            if isinstance(repeat, dict) and repeat.get("identical") is False and isinstance(engine.get("engine"), str):
                found.add((system, ranker_label(engine["engine"])))
    return found


def flatten(report: dict[str, Any]) -> dict[tuple[str, str, str, str], float]:
    """Map (system, ranker, class, metric) -> score."""
    flat: dict[tuple[str, str, str, str], float] = {}
    for system, ranker, class_name, bucket in iter_buckets(report):
        metrics = metrics_from(bucket)
        if metrics is None:
            continue
        for metric, value in metrics.items():
            flat[(system, ranker, class_name, metric)] = value
    return flat


def query_counts(report: dict[str, Any]) -> dict[tuple[str, str, str], int]:
    counts: dict[tuple[str, str, str], int] = {}
    for system, ranker, class_name, bucket in iter_buckets(report):
        count = bucket.get("n")
        if isinstance(count, int) and not isinstance(count, bool):
            counts[(system, ranker, class_name)] = count
    return counts


NESSO_MODES = ("auto", "hybrid", "dense", "lexical")
# Below this many queries, one query moves a class's MRR by more than ~3%.
NOISE_QUERY_COUNT = 30


def headline_nesso_mode(flat: dict[tuple[str, str, str, str], float]) -> str | None:
    present = {ranker for _system, ranker, _class, _metric in flat}
    for mode in NESSO_MODES:
        if mode in present:
            return mode
    return None


# Paired bootstrap over queries for the margin's confidence interval.
BOOTSTRAP_RESAMPLES = 5000
CONFIDENCE = 0.95


def iter_query_lists(report: dict[str, Any]) -> list[tuple[str, str, Any]]:
    """Every (dataset, ranker, queries) in report order; skipped engines are left out."""
    found: list[tuple[str, str, Any]] = []
    for entry in report.get("datasets") or []:
        if not isinstance(entry, dict) or not isinstance(entry.get("dataset"), str):
            continue
        dataset = entry["dataset"]
        if "engines" in entry:
            for engine in entry.get("engines") or []:
                if not isinstance(engine, dict) or engine.get("status") == "skipped":
                    continue
                name = engine.get("engine")
                if not isinstance(name, str):
                    continue
                if "modes" in engine:
                    for mode in engine.get("modes") or []:
                        found.append((dataset, str(mode.get("mode")), mode.get("queries")))
                else:
                    found.append((dataset, ranker_label(name), engine.get("queries")))
        else:
            for mode in entry.get("modes") or []:
                found.append((dataset, str(mode.get("mode")), mode.get("queries")))
    return found


def query_scores(report: dict[str, Any], metric: str = "mrr") -> dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]]:
    """(system, ranker) -> {(dataset, query id): (class, score)}; system "overall" pools every dataset."""
    scores: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]] = {}
    for dataset, ranker, queries in iter_query_lists(report):
        if not isinstance(queries, list):
            continue
        for query in queries:
            if not isinstance(query, dict):
                continue
            value = (query.get("metrics") or {}).get(metric)
            if not isinstance(value, (int, float)) or isinstance(value, bool):
                continue
            entry = (str(query.get("class")), float(value))
            key = (dataset, str(query.get("id")))
            scores.setdefault((dataset, ranker), {})[key] = entry
            scores.setdefault(("overall", ranker), {})[key] = entry
    return scores


def first_hit_ranks(report: dict[str, Any]) -> dict[tuple[str, str, str], int | None]:
    """(dataset, ranker, query id) -> rank of the first relevant hit, None when none was found."""
    ranks: dict[tuple[str, str, str], int | None] = {}
    for dataset, ranker, queries in iter_query_lists(report):
        for query in queries if isinstance(queries, list) else []:
            if not isinstance(query, dict) or "first_hit_rank" not in query:
                continue
            rank = query.get("first_hit_rank")
            ranks[(dataset, ranker, str(query.get("id")))] = rank if isinstance(rank, int) and not isinstance(rank, bool) else None
    return ranks


def paired_differences(
    ours: dict[tuple[str, str], tuple[str, float]],
    theirs: dict[tuple[str, str], tuple[str, float]],
    class_name: str,
) -> list[float]:
    """Per-query score differences on the queries both rankers answered, in a stable order."""
    shared = sorted(
        key for key, (cls, _score) in ours.items() if key in theirs and (class_name == "overall" or cls == class_name)
    )
    return [ours[key][1] - theirs[key][1] for key in shared]


def bootstrap_interval(differences: list[float], label: str) -> tuple[float, float] | None:
    """Percentile interval of the mean difference. Seeded from the label, so reruns print the same bounds."""
    if not differences:
        return None
    rng = random.Random(zlib.crc32(label.encode("utf-8")))
    count = len(differences)
    means = sorted(sum(rng.choices(differences, k=count)) / count for _ in range(BOOTSTRAP_RESAMPLES))
    tail = (1.0 - CONFIDENCE) / 2.0
    low = means[int(tail * BOOTSTRAP_RESAMPLES)]
    high = means[min(BOOTSTRAP_RESAMPLES - 1, int((1.0 - tail) * BOOTSTRAP_RESAMPLES))]
    return low, high


def verdict(interval: tuple[float, float] | None) -> str:
    if interval is None:
        return "—"
    low, high = interval
    if low > 0:
        return "win"
    if high < 0:
        return "loss"
    return "tie"


def margin_report(current: dict[str, Any], references: list[dict[str, Any]]) -> dict[str, Any]:
    """Per system and class: nesso against the best other engine, by MRR.

    The same rows feed the Markdown table and `--margins-json`, so a later run can
    compare margins without re-reading the reports.
    """
    cur = flatten(current)
    counts = query_counts(current)
    nesso = headline_nesso_mode(cur)
    family = report_family(current)
    if nesso is None:
        return {"family": family, "nesso": None, "referencesUsed": 0, "rows": []}
    rivals: dict[tuple[str, str], dict[str, tuple[float, float, str]]] = {}
    per_query = query_scores(current)
    rival_queries: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]] = {}
    unstable: set[tuple[str, str, str]] = set()

    def add_rivals(report: dict[str, Any], source: str) -> None:
        unstable.update((system, ranker, source) for system, ranker in unstable_rankers(report))
        flat = flatten(report)
        for (system, ranker, class_name, metric), value in flat.items():
            if metric != "mrr" or ranker in NESSO_MODES:
                continue
            bucket = rivals.setdefault((system, class_name), {})
            if ranker in bucket:
                continue
            bucket[ranker] = (value, flat.get((system, ranker, class_name, "ndcg_at_10"), 0.0), source)
        for key, scores in query_scores(report).items():
            if key[1] not in NESSO_MODES:
                rival_queries.setdefault(key, scores)

    add_rivals(current, "this run")
    used = 0
    for reference in references:
        if report_family(reference) != family:
            continue
        used += 1
        add_rivals(reference, "reference")

    order: list[tuple[str, str]] = []
    for system, ranker, class_name, _bucket in iter_buckets(current):
        if ranker == nesso and (system, class_name) not in order and (system, nesso, class_name, "mrr") in cur:
            order.append((system, class_name))

    rows: list[dict[str, Any]] = []
    for system, class_name in order:
        count = counts.get((system, nesso, class_name))
        nesso_mrr = cur[(system, nesso, class_name, "mrr")]
        nesso_ndcg = cur.get((system, nesso, class_name, "ndcg_at_10"), 0.0)
        row: dict[str, Any] = {
            "system": system,
            "class": class_name,
            "n": count,
            "nessoMrr": nesso_mrr,
            "nessoNdcgAt10": nesso_ndcg,
            "bestOther": None,
            "otherSource": None,
            "unstable": False,
            "otherMrr": None,
            "otherNdcgAt10": None,
            "margin": None,
            "ciLow": None,
            "ciHigh": None,
            "verdict": "—",
        }
        candidates = rivals.get((system, class_name), {})
        if candidates:
            name, (other_mrr, other_ndcg, source) = max(candidates.items(), key=lambda item: (item[1][0], item[0]))
            differences = paired_differences(
                per_query.get((system, nesso), {}), rival_queries.get((system, name), {}), class_name
            )
            interval = bootstrap_interval(differences, f"{system}/{class_name}/{nesso}/{name}")
            row.update(
                {
                    "bestOther": name,
                    "otherSource": source,
                    "unstable": (system, name, source) in unstable,
                    "otherMrr": other_mrr,
                    "otherNdcgAt10": other_ndcg,
                    "margin": nesso_mrr - other_mrr,
                    "verdict": verdict(interval),
                }
            )
            if interval is not None:
                row["ciLow"], row["ciHigh"] = interval
        rows.append(row)
    return {"family": family, "nesso": nesso, "referencesUsed": used, "rows": rows}


def margins(current: dict[str, Any], references: list[dict[str, Any]]) -> str:
    """Per system and class: nesso against the best other engine, by MRR."""
    report = margin_report(current, references)
    family = report["family"]
    nesso = report["nesso"]
    if nesso is None:
        return f"### nesso margin ({family})\n\nno nesso rows in the current report\n"
    lines = [
        f"### nesso margin ({family}, nesso `{nesso}` against the best other engine by MRR)",
        "",
        "| system | class | n | nesso MRR | nesso nDCG@10 | best other | other MRR | other nDCG@10 | margin | 95% CI | verdict |",
        "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    small = False
    marked = False
    for row in report["rows"]:
        count = row["n"]
        if count is not None and count < NOISE_QUERY_COUNT:
            small = True
        if row["bestOther"] is None:
            other = ["none", "—", "—", "—", "—", "—"]
        else:
            label = row["bestOther"] if row["otherSource"] == "this run" else f"{row['bestOther']} (reference)"
            if row["unstable"]:
                label += " †"
                marked = True
            spread = "—" if row["ciLow"] is None else f"[{row['ciLow']:+.3f}, {row['ciHigh']:+.3f}]"
            other = [
                label,
                f"{row['otherMrr']:.3f}",
                f"{row['otherNdcgAt10']:.3f}",
                f"{row['margin']:+.3f}",
                spread,
                row["verdict"],
            ]
        lines.append(
            "| "
            + " | ".join(
                [
                    row["system"],
                    row["class"],
                    "—" if count is None else str(count),
                    f"{row['nessoMrr']:.3f}",
                    f"{row['nessoNdcgAt10']:.3f}",
                    *other,
                ]
            )
            + " |"
        )
    lines.append("")
    lines.append(
        f"Margin is nesso MRR minus the best other engine's MRR. References used: {report['referencesUsed']}. "
        f"95% CI: paired bootstrap of the per-query MRR difference ({BOOTSTRAP_RESAMPLES} resamples, "
        "seeded per row so it is reproducible) on the queries both engines answered. "
        "win or loss when the interval excludes 0, tie when it contains 0."
        + (
            f" Some classes have fewer than {NOISE_QUERY_COUNT} queries; there one query moves MRR by more than 1/{NOISE_QUERY_COUNT}, so small margins are noise."
            if small
            else ""
        )
        + (
            " † The engine's rankings changed between repeated quality runs (`--quality-repeat`); "
            "its median run is shown, and the report's `quality_repeat` has the range."
            if marked
            else ""
        )
    )
    return "\n".join(lines) + "\n"


def format_score(value: float | None) -> str:
    if value is None:
        return "—"
    return f"{value:.6f}"


def format_change(current: float | None, previous: float | None) -> str:
    if current is None or previous is None:
        return "—"
    if previous <= 0:
        return "n/a"
    return f"{(current - previous) / previous * 100.0:+.1f}%"


def resolve_tolerance(explicit: float | None) -> float:
    if explicit is not None:
        value = explicit
    else:
        raw = os.environ.get("NESSO_EVAL_TOLERANCE", "")
        if raw != "":
            try:
                value = float(raw)
            except ValueError as exc:
                raise SystemExit(f"error: invalid NESSO_EVAL_TOLERANCE: {exc}") from exc
        else:
            value = DEFAULT_TOLERANCE
    if value < 0:
        raise SystemExit("error: tolerance must be >= 0")
    return value


# Queries listed under "Queries whose MRR changed" before the rest are summarised.
MOVED_QUERY_LIMIT = 30


def class_queries(scores: dict[tuple[str, str], tuple[str, float]], class_name: str) -> set[tuple[str, str]]:
    """The query keys of one class, or of every class for "overall"."""
    return {key for key, (cls, _score) in scores.items() if class_name == "overall" or cls == class_name}


def change_interval(
    cur_queries: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]],
    prev_queries: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]],
    system: str,
    ranker: str,
    class_name: str,
) -> tuple[float, float] | None:
    """Paired bootstrap interval of current minus previous per-query MRR, on the queries both runs scored."""
    differences = paired_differences(
        cur_queries.get((system, ranker), {}), prev_queries.get((system, ranker), {}), class_name
    )
    return bootstrap_interval(differences, f"change/{system}/{ranker}/{class_name}")


def change_verdict(interval: tuple[float, float]) -> str:
    return {"win": "better", "loss": "worse", "tie": "within noise"}[verdict(interval)]


def query_set_change(
    ours: dict[tuple[str, str], tuple[str, float]],
    theirs: dict[tuple[str, str], tuple[str, float]],
    class_name: str,
) -> str | None:
    """A note when the two runs scored different queries in this class, else None.

    The class score then moves with the query set, so an interval over the shared queries says
    nothing about it.
    """
    current = class_queries(ours, class_name)
    previous = class_queries(theirs, class_name)
    if current == previous:
        return None
    return f"query set changed: {len(current & previous)} shared of {len(current)} current, {len(previous)} previous"


def change_note(
    cur_queries: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]],
    prev_queries: dict[tuple[str, str], dict[tuple[str, str], tuple[str, float]]],
    system: str,
    ranker: str,
    class_name: str,
) -> str:
    """What a DROP line adds for MRR: the query-set change, or the interval and verdict."""
    ours = cur_queries.get((system, ranker))
    theirs = prev_queries.get((system, ranker))
    if not ours or not theirs:
        return ""
    changed = query_set_change(ours, theirs, class_name)
    if changed is not None:
        return f", {changed}"
    interval = change_interval(cur_queries, prev_queries, system, ranker, class_name)
    if interval is None:
        return ""
    return f", 95% CI [{interval[0]:+.3f}, {interval[1]:+.3f}] {change_verdict(interval)}"


def format_rank(rank: int | None) -> str:
    return "not found" if rank is None else str(rank)


def mrr_changes(current: dict[str, Any], previous: dict[str, Any]) -> list[str]:
    """Per-query view of MRR: paired intervals for the classes whose queries changed, then the queries."""
    cur_queries = query_scores(current)
    prev_queries = query_scores(previous)
    rows: list[str] = []
    moved: list[tuple[float, str, str, str, str, float, float]] = []
    for system, ranker in sorted(set(cur_queries) & set(prev_queries)):
        ours = cur_queries[(system, ranker)]
        theirs = prev_queries[(system, ranker)]
        classes = sorted({cls for cls, _score in [*ours.values(), *theirs.values()]})
        for class_name in [*classes, "overall"]:
            differences = paired_differences(ours, theirs, class_name)
            changed = query_set_change(ours, theirs, class_name)
            if changed is None and not any(differences):
                continue
            mean = f"{sum(differences) / len(differences):+.3f}" if differences else "—"
            if changed is not None:
                spread, label = "—", changed
            else:
                interval = change_interval(cur_queries, prev_queries, system, ranker, class_name)
                assert interval is not None
                spread, label = f"[{interval[0]:+.3f}, {interval[1]:+.3f}]", change_verdict(interval)
            rows.append(
                f"| {system} | {ranker} | {class_name} | {len(differences)} | {mean} | {spread} | {label} |"
            )
        if system == "overall":
            continue
        for key in sorted(set(ours) & set(theirs)):
            if ours[key][1] != theirs[key][1]:
                moved.append((abs(ours[key][1] - theirs[key][1]), system, ranker, key[1], ours[key][0], theirs[key][1], ours[key][1]))
    if not rows:
        return []
    lines = [
        "",
        "#### MRR change by query",
        "",
        "Rows only for classes where at least one query's MRR changed or the two runs scored different "
        "queries. n and change count the queries both runs scored. 95% CI: paired bootstrap of the "
        f"per-query MRR difference (current minus previous, {BOOTSTRAP_RESAMPLES} resamples, seeded per row). "
        "better or worse when the interval excludes 0, within noise when it contains 0. "
        "When the query set changed, the class score moved with it, so no interval or verdict is given.",
        "",
        "| system | ranker | class | n | change | 95% CI | verdict |",
        "| --- | --- | --- | --- | --- | --- | --- |",
        *rows,
    ]
    if moved:
        cur_ranks = first_hit_ranks(current)
        prev_ranks = first_hit_ranks(previous)
        moved.sort(key=lambda item: (-item[0], item[1], item[2], item[3]))
        lines.extend(["", "Queries whose MRR changed, largest change first:", ""])
        for _size, system, ranker, query_id, class_name, before, after in moved[:MOVED_QUERY_LIMIT]:
            rank_key = (system, ranker, query_id)
            ranks = ""
            if rank_key in cur_ranks and rank_key in prev_ranks:
                ranks = f", first hit {format_rank(prev_ranks[rank_key])} -> {format_rank(cur_ranks[rank_key])}"
            lines.append(f"- {system} {ranker} {query_id} ({class_name}): MRR {before:.3f} -> {after:.3f}{ranks}")
        if len(moved) > MOVED_QUERY_LIMIT:
            lines.append(f"- and {len(moved) - MOVED_QUERY_LIMIT} more")
    return lines


def compare(current: dict[str, Any], previous: dict[str, Any], tolerance: float) -> tuple[str, list[str]]:
    if not comparable(current, previous):
        note = (
            f"schema_version mismatch: current={report_family(current)} {current['schema_version']} "
            f"previous={report_family(previous)} {previous['schema_version']}; skipping comparison"
        )
        return note, []

    cur = flatten(current)
    prev = flatten(previous)
    keys = sorted(set(cur) | set(prev))
    cur_queries = query_scores(current)
    prev_queries = query_scores(previous)

    pct = int(round(tolerance * 100))
    lines = [
        f"### Retrieval eval compare (tolerance {pct}%)",
        "",
        "| system | ranker | class | metric | current | previous | change | status |",
        "| --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    drops: list[str] = []

    for key in keys:
        system, mode, class_name, metric = key
        c_val = cur.get(key)
        p_val = prev.get(key)
        if c_val is None and p_val is not None:
            status = "removed"
        elif c_val is not None and p_val is None:
            status = "new"
        elif c_val is not None and p_val is not None and p_val > 0 and c_val < p_val * (1.0 - tolerance):
            status = "drop"
            change = format_change(c_val, p_val)
            note = change_note(cur_queries, prev_queries, system, mode, class_name) if metric == "mrr" else ""
            drops.append(
                f"DROP {system} {mode} {class_name} {metric}: "
                f"{format_score(p_val)} -> {format_score(c_val)} ({change}{note})"
            )
        else:
            status = "ok"

        lines.append(
            "| "
            + " | ".join(
                [
                    system,
                    mode,
                    class_name,
                    metric,
                    format_score(c_val),
                    format_score(p_val),
                    format_change(c_val, p_val),
                    status,
                ]
            )
            + " |"
        )

    lines.extend(mrr_changes(current, previous))

    if drops:
        lines.append("")
        lines.extend(drops)

    return "\n".join(lines) + "\n", drops


# Exit status of --fail-on-worse when a nesso ranker got worse, distinct from errors (1, 2).
WORSE_EXIT = 3


# Metrics --fail-on-worse checks: the first relevant hit and the quality of the top 10.
GATE_METRICS = ("mrr", "ndcg_at_10")


def worse_changes(current: dict[str, Any], previous: dict[str, Any]) -> list[str]:
    """One WORSE line per nesso ranker, system, class, and gate metric that got worse beyond noise.

    Only classes where both runs scored the same queries count: there the paired interval of the
    per-query change lies entirely below 0. A changed query set never counts.
    """
    found: list[str] = []
    for metric in GATE_METRICS:
        cur_queries = query_scores(current, metric)
        prev_queries = query_scores(previous, metric)
        for system, ranker in sorted(set(cur_queries) & set(prev_queries)):
            if ranker not in NESSO_MODES:
                continue
            ours = cur_queries[(system, ranker)]
            theirs = prev_queries[(system, ranker)]
            classes = sorted({cls for cls, _score in [*ours.values(), *theirs.values()]})
            for class_name in [*classes, "overall"]:
                if query_set_change(ours, theirs, class_name) is not None:
                    continue
                differences = paired_differences(ours, theirs, class_name)
                interval = bootstrap_interval(differences, f"worse/{metric}/{system}/{ranker}/{class_name}")
                if interval is None or verdict(interval) != "loss":
                    continue
                mean = sum(differences) / len(differences)
                found.append(
                    f"WORSE {system} {ranker} {class_name} {metric}: {mean:+.3f} over {len(differences)} queries, "
                    f"95% CI [{interval[0]:+.3f}, {interval[1]:+.3f}]"
                )
    return found


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--current", type=Path, required=True, help="Current eval JSON report")
    parser.add_argument("--previous", type=Path, default=None, help="Previous eval JSON report")
    parser.add_argument(
        "--margins",
        action="store_true",
        help="Print nesso against the best other engine per system and class (no --previous needed)",
    )
    parser.add_argument(
        "--margins-json",
        action="store_true",
        help="With the margin calculation, print the rows as JSON instead of the Markdown table",
    )
    parser.add_argument(
        "--reference",
        type=Path,
        action="append",
        default=None,
        help="Report with more engines for --margins (repeatable; other report kinds are ignored)",
    )
    parser.add_argument(
        "--fail-on-worse",
        action="store_true",
        help=f"With --previous: exit {WORSE_EXIT} when a nesso ranker's MRR or nDCG@10 got worse beyond noise on an unchanged query set",
    )
    parser.add_argument(
        "--tolerance",
        type=float,
        default=None,
        help=f"Relative drop fraction that marks a drop (default {DEFAULT_TOLERANCE})",
    )
    args = parser.parse_args()

    try:
        tolerance = resolve_tolerance(args.tolerance)
    except SystemExit:
        raise
    except ValueError as exc:
        raise SystemExit(f"error: invalid tolerance: {exc}") from exc

    wants_margins = args.margins or args.margins_json
    if args.previous is None and not wants_margins:
        raise SystemExit("error: pass --previous, --margins, or both")
    if args.fail_on_worse and args.previous is None:
        raise SystemExit("error: --fail-on-worse needs --previous")
    current = load_report(args.current)
    if wants_margins:
        references = [load_report(path) for path in args.reference or []]
        if args.margins_json:
            sys.stdout.write(json.dumps(margin_report(current, references)) + "\n")
        else:
            sys.stdout.write(margins(current, references))
    if args.previous is not None:
        previous = load_report(args.previous)
        text, _drops = compare(current, previous, tolerance)
        sys.stdout.write(text)
        if args.fail_on_worse:
            worse = worse_changes(current, previous)
            if worse:
                sys.stdout.write("\n" + "\n".join(worse) + "\n")
                return WORSE_EXIT
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0) from None
