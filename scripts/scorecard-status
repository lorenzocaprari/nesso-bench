#!/usr/bin/env python3
"""Summarize scorecard runs as Markdown: which engine finished which suite.

    scripts/scorecard-status results/0.3.1 [more results directories ...]

Reads status.json (and machine.json, when present) from each directory
scripts/scorecard wrote, and prints three things: the machine each run was on and the nesso it scored
(marked "(binary)" when it was not a pinned release),
a table of engine group by suite with each run's outcome and wall time, and
every run that did not finish with its exit code. `--no-times` leaves the wall
time out of that table, for a summary that must not set timings from different
runners side by side. Several directories merge
into one table, which is how the CI smoke run combines its per-engine jobs; a
group that ran in more than one directory (nesso main and its release
baseline) gets one row per directory, labelled with the directory name.
An outcome other than ok is a finding, not an error here: this exits 0 when it
could read at least one directory and 1 when it could read none.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any


def load(path: Path) -> Any | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def wall(seconds: float | None) -> str:
    if seconds is None:
        return "?"
    if seconds < 120:
        return f"{seconds:.0f} s"
    if seconds < 7200:
        return f"{seconds / 60:.0f} min"
    return f"{seconds / 3600:.1f} h"


def cell(run: dict[str, Any], *, times: bool = True) -> str:
    outcome = str(run.get("outcome", "?"))
    if not times:
        return outcome
    return f"{outcome} ({wall(run.get('wallSeconds'))})"


def table(headers: list[str], rows: list[list[str]]) -> list[str]:
    lines = ["| " + " | ".join(headers) + " |", "|" + " --- |" * len(headers)]
    lines += ["| " + " | ".join(row) + " |" for row in rows]
    return lines


def nesso_cell(machine: dict[str, Any]) -> str:
    """The nesso scored, and whether it was a pinned release or a binary built elsewhere."""
    version = str(machine.get("nessoVersion", "?"))
    return f"{version} (binary)" if machine.get("nessoSource") == "binary" else version


def machine_row(directory: Path, machine: dict[str, Any]) -> list[str]:
    memory = machine.get("memTotalBytes")
    return [
        directory.name,
        nesso_cell(machine),
        str(machine.get("cpuModel", "?")),
        str(machine.get("nproc", "?")),
        "?" if memory is None else f"{memory / 2**30:.0f} GiB",
        str(machine.get("memoryMax", "?")),
        "yes" if machine.get("developmentOnly") else "no",
    ]


def label_shared_groups(per_directory: list[tuple[Path, list[dict[str, Any]]]]) -> list[dict[str, Any]]:
    """Every run; a group found in more than one directory is labelled with its directory."""
    seen: dict[str, set[str]] = {}
    for directory, found in per_directory:
        for run in found:
            seen.setdefault(str(run.get("group")), set()).add(directory.name)
    runs = []
    for directory, found in per_directory:
        for run in found:
            group = str(run.get("group"))
            runs.append({**run, "group": f"{group} ({directory.name})"} if len(seen[group]) > 1 else run)
    return runs


def summarize(directories: list[Path], *, times: bool = True) -> tuple[str, int]:
    per_directory: list[tuple[Path, list[dict[str, Any]]]] = []
    machines: list[list[str]] = []
    unreadable: list[str] = []
    for directory in directories:
        status = load(directory / "status.json")
        if not isinstance(status, dict) or not isinstance(status.get("runs"), list):
            unreadable.append(directory.name)
            continue
        per_directory.append((directory, [run for run in status["runs"] if isinstance(run, dict)]))
        machine = load(directory / "machine.json")
        if isinstance(machine, dict):
            machines.append(machine_row(directory, machine))
    runs = label_shared_groups(per_directory)
    lines: list[str] = ["### Scorecard runs", ""]
    if machines:
        lines += table(["results", "nesso", "CPU", "logical CPUs", "RAM", "memory cap", "development only"], machines) + [""]
    if not runs:
        lines += ["No runs found."]
    else:
        groups = list(dict.fromkeys(str(run.get("group")) for run in runs))
        suites = list(dict.fromkeys(str(run.get("suite")) for run in runs))
        by_key = {(str(run.get("group")), str(run.get("suite"))): run for run in runs}
        rows = [
            [group] + [cell(by_key[(group, suite)], times=times) if (group, suite) in by_key else "—" for suite in suites]
            for group in groups
        ]
        lines += table(["engine group", *suites], rows) + [""]
        failed = [run for run in runs if run.get("outcome") != "ok"]
        finished = len(runs) - len(failed)
        lines += [f"{finished} of {len(runs)} runs ok."]
        if failed:
            lines += [""] + table(
                ["suite", "group", "outcome", "exit code"],
                [[str(run.get("suite")), str(run.get("group")), str(run.get("outcome")), str(run.get("exitCode"))] for run in failed],
            )
    if unreadable:
        lines += ["", "No readable status.json in: " + ", ".join(unreadable) + "."]
    return "\n".join(lines) + "\n", 0 if runs or not unreadable else 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("results", type=Path, nargs="+", help="scripts/scorecard results directories")
    parser.add_argument(
        "--no-times",
        action="store_true",
        help="Print outcomes only. Wall times from different runners are not a comparison",
    )
    args = parser.parse_args(argv)
    text, code = summarize(args.results, times=not args.no_times)
    sys.stdout.write(text)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
