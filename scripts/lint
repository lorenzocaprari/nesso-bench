#!/usr/bin/env bash
# Runs the pre-commit hooks (hygiene and ruff) over the whole tree.
# scripts/actionlint and scripts/zizmor lint .github/workflows separately.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"
if ! command -v pre-commit >/dev/null 2>&1; then
  echo "error: pre-commit is not installed (python3 -m pip install pre-commit==4.7.0)" >&2
  exit 1
fi
exec pre-commit run --all-files --show-diff-on-failure "$@"
