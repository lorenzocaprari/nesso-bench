#!/usr/bin/env python3
"""Build the support bundle from pinned Loghub 2k samples.

    scripts/build-bundle [--out build/bench/bundle]

A support engineer gets a directory of logs, some rotated and compressed, some
inside archives, and searches all of it. This builds that from six Loghub 2k
samples (fetched and sha256-checked by scripts/fetch-loghub), in the formats
nesso reads in place:

    bundle/sos_reports/bgl-ras.tar              BGL, in a tar member
    bundle/sos_reports/thunderbird.tgz          Thunderbird, in a gzipped tar member
    bundle/var/log/hdfs/datanode.log.1          HDFS, a rotated plain file
    bundle/var/log/httpd/error_log.zip          Apache, in a zip member
    bundle/var/log/messages                     Linux, a plain file
    bundle/var/log/secure-20051210.gz           OpenSSH, a gzip file

It also writes what a scorer needs: manifest.json next to the bundle directory
(the sources in nesso's visiting order, with their system, container, line
count, line offset, and decoded sha256), and, one level up like a 2k log,

    SupportBundle_concat.log         every source's lines, in that order, as one
                                     file: a line's id is its position in it
    SupportBundle_concat.log_structured.csv
                                     LineId and EventId, with each event id
                                     prefixed by its system (hdfs:E10)

nesso reads the bundle directory itself. Every other engine reads the
concatenated file, already decoded, which is easier for it than the real
bundle. Output is deterministic: gzip, tar, and zip metadata are fixed, and
the manifest records the decoded content, not the compressed bytes (those
depend on the zlib version).
"""

from __future__ import annotations

import argparse
import csv
import gzip
import hashlib
import io
import json
import sys
import tarfile
import zipfile
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BENCH_DIR = ROOT / "build" / "bench"
DEFAULT_OUT = BENCH_DIR / "bundle"
ROOT_NAME = "bundle"
CONCAT_NAME = "SupportBundle_concat.log"


@dataclass(frozen=True)
class Source:
    system: str  # prefix of the event ids and the first part of the query ids
    sample: str  # Loghub 2k log file name in build/bench
    relpath: str  # path under the bundle root
    container: str  # plain, gz, tar, tgz, or zip
    member: str | None = None  # member name inside a tar, tgz, or zip


SOURCES = (
    Source("bgl", "BGL_2k.log", "sos_reports/bgl-ras.tar", "tar", "var/log/bgl/ras.log"),
    Source("thunderbird", "Thunderbird_2k.log", "sos_reports/thunderbird.tgz", "tgz", "var/log/thunderbird/syslog"),
    Source("hdfs", "HDFS_2k.log", "var/log/hdfs/datanode.log.1", "plain"),
    Source("apache", "Apache_2k.log", "var/log/httpd/error_log.zip", "zip", "error_log"),
    Source("linux", "Linux_2k.log", "var/log/messages", "plain"),
    Source("openssh", "OpenSSH_2k.log", "var/log/secure-20051210.gz", "gz"),
)
# nesso orders the files of a directory by the unsigned byte order of the full
# path, so the sources must already be in that order.
assert [source.relpath for source in SOURCES] == sorted((source.relpath for source in SOURCES), key=str.encode)


def write_gzip(path: Path, data: bytes) -> None:
    with path.open("wb") as handle, gzip.GzipFile(filename="", mode="wb", fileobj=handle, compresslevel=9, mtime=0) as gz:
        gz.write(data)


def write_tar(path: Path, member: str, data: bytes, *, gzipped: bool) -> None:
    info = tarfile.TarInfo(member)
    info.size = len(data)
    info.mtime = 0
    info.mode = 0o644
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w", format=tarfile.PAX_FORMAT) as archive:
        archive.addfile(info, io.BytesIO(data))
    if gzipped:
        write_gzip(path, buffer.getvalue())
    else:
        path.write_bytes(buffer.getvalue())


def write_zip(path: Path, member: str, data: bytes) -> None:
    info = zipfile.ZipInfo(member, date_time=(1980, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o644 << 16
    with zipfile.ZipFile(path, "w") as archive:
        archive.writestr(info, data, compresslevel=9)


def nesso_label(source: Source) -> str:
    """The `source` nesso prints for a line of this file: the path as given, plus :member for an archive."""
    path = f"{ROOT_NAME}/{source.relpath}"
    return path if source.member is None else f"{path}:{source.member}"


def read_events(sample: str) -> list[str]:
    with (BENCH_DIR / f"{sample}_structured.csv").open(encoding="utf-8", newline="") as handle:
        return [row["EventId"] for row in csv.DictReader(handle)]


def build(out: Path) -> dict:
    bundle = out / ROOT_NAME
    entries = []
    concat: list[str] = []
    events: list[str] = []
    for source in SOURCES:
        sample = BENCH_DIR / source.sample
        if not sample.is_file():
            raise SystemExit(f"error: {sample} is missing; run scripts/fetch-loghub --dataset all-2k")
        data = sample.read_bytes()
        lines = data.decode("utf-8", errors="replace").split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        sample_events = read_events(source.sample)
        if len(sample_events) != len(lines):
            raise SystemExit(f"error: {source.sample} has {len(lines)} lines but {len(sample_events)} event labels")
        target = bundle / source.relpath
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.container == "plain":
            target.write_bytes(data)
        elif source.container == "gz":
            write_gzip(target, data)
        elif source.container == "tar":
            write_tar(target, source.member or "", data, gzipped=False)
        elif source.container == "tgz":
            write_tar(target, source.member or "", data, gzipped=True)
        else:
            write_zip(target, source.member or "", data)
        entries.append(
            {
                "container": source.container,
                "lineCount": len(lines),
                "lineOffset": len(concat),
                "member": source.member,
                "path": f"{ROOT_NAME}/{source.relpath}",
                "sha256": hashlib.sha256(data).hexdigest(),
                "source": nesso_label(source),
                "system": source.system,
            }
        )
        concat.extend(lines)
        events.extend(f"{source.system}:{event}" for event in sample_events)
    # The concatenated log and its labels sit beside the bundle directory, as a 2k log and its CSV do.
    (out.parent / CONCAT_NAME).write_text("\n".join(concat) + "\n", encoding="utf-8")
    with (out.parent / f"{CONCAT_NAME}_structured.csv").open("w", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle, lineterminator="\n")
        writer.writerow(["LineId", "EventId"])
        for number, event in enumerate(events, start=1):
            writer.writerow([number, event])
    manifest = {"root": ROOT_NAME, "sources": entries, "totalLines": len(concat)}
    (out / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return manifest


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT, help=f"Directory for the bundle (default {DEFAULT_OUT})")
    args = parser.parse_args(argv)
    args.out.mkdir(parents=True, exist_ok=True)
    manifest = build(args.out)
    print(f"build-bundle: {len(manifest['sources'])} sources, {manifest['totalLines']} lines in {args.out}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
